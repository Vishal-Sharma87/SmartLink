# Spring profile
SPRING_PROFILES_ACTIVE=local

# MongoDB
MONGODB_URI=mongodb://localhost:27017/urlshortener

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_JAAS_CONFIG=
KAFKA_SESSION_TIMEOUT=45000
KAFKA_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_VALUE_SERIALIZER=org.springframework.kafka.support.serializer.JsonSerializer
KAFKA_CONSUMER_GROUP_ID=url-shortener-group
KAFKA_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
KAFKA_VALUE_DESERIALIZER=org.springframework.kafka.support.serializer.JsonDeserializer

# Application settings
CLIENT_ID=local-client-id
COMPANY_DOMAIN=http://localhost:8080
COMPANY_ENDPOINT=http://localhost:8080
JWT_SECRET_KEY=replace-with-a-long-random-secret

# VirusTotal
VT_API_KEY=replace-with-your-virustotal-api-key
VT_ANALYSIS_URL=https://www.virustotal.com/api/v3/urls

# SendGrid
SENDGRID_API_KEY=replace-with-your-sendgrid-api-key
SENDGRID_EMAIL=verified-sender@example.com

# Docker Compose overrides
MONGODB_DATABASE=urlshortener
MONGODB_IMAGE_TAG=8.0
MONGODB_PORT=27017
REDIS_IMAGE_TAG=7.4-alpine
KAFKA_IMAGE_TAG=3.9.0
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost

IP_INFO_TOKEN=pasteYourIpInfoToken