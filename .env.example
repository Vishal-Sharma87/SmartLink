# **  Application **

SPRING_PROFILES_ACTIVE=local
COMPANY_ENDPOINT=http://localhost:8080


# **  MongoDB **

MONGODB_URI=mongodb://localhost:27017/smartlink
MONGODB_DATABASE=smartlink


# **  Redis **

REDIS_HOST=localhost
REDIS_PORT=6379

REDIS_REDIRECTION_CACHE_PREFIX=smart-link:redirection-hash:
URL_COUNTER_KEY=url_counter
REDIRECTION_CACHE_STATUS_HASH_KEY=status
REDIRECTION_CACHE_LONG_URL_HASH_KEY=longUrl


# **  Kafka **

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_JAAS_CONFIG=
KAFKA_SESSION_TIMEOUT=45000

KAFKA_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_VALUE_SERIALIZER=org.springframework.kafka.support.serializer.JsonSerializer

KAFKA_LINK_CREATION_GROUP_ID=smart-link.link-creation-consumer-group
KAFKA_LINK_ANALYSIS_GROUP_ID=smart-link.link-analysis-consumer-group

KAFKA_TOPIC_LINK_CREATION=smart-link.link_creation
KAFKA_TOPIC_LINK_ANALYSIS=smart-link.link_analysis


# **  Container Configuration **

MONGODB_IMAGE_TAG=7.0
MONGODB_PORT=27017

REDIS_IMAGE_TAG=7.4-alpine

KAFKA_IMAGE_TAG=3.9.0
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost


# **  Database Field Names **

SMART_LINK_ID=id
SMART_LINK_ACTUAL_URL=actualUrl
SMART_LINK_HASHED_KEY=hashedKey
SMART_LINK_OWNER_USERNAME=ownerUserName
SMART_LINK_STATUS=status
SMART_LINK_REPORT_COUNT=reportCount
SMART_LINK_CLICK_COUNT=clickCount

SMART_LINK_USERS_MALICIOUS_URLS_CREATED_COUNT=maliciousUrlsCreatedCount
SMART_LINK_ABUSE_REPORT_REPORTER_EMAIL=reporterEmail


# **  Redirection Pages **

ERROR_PAGE=error
TRACK_PAGE=track
SUSPICIOUS_WARNING_PAGE=suspicious-warning
MALICIOUS_PAGE=malicious-warning


# **  API Response Messages **

API_RESPONSE_LINK_CREATED=Link created successfully.
API_RESPONSE_LINK_CREATION_PENDING=Link creation is pending analysis.
API_RESPONSE_ALL_LINKS_OF_USER_MESSAGE=All links retrieved successfully.
API_RESPONSE_SIGNUP_INITIATED=Signup initiated successfully. Please verify your email.
API_RESPONSE_LINK_DELETED=Link deleted successfully.
API_RESPONSE_ALL_LINKS_OF_USER_DELETED=All links of the user deleted successfully.
API_RESPONSE_REPORT_ACCEPTED=Abuse report accepted successfully.
API_RESPONSE_MALFORMED_SIGNUP_SESSION=The signup session is malformed or invalid.
API_RESPONSE_USER_DELETED=User deleted successfully.
API_RESPONSE_AUTH_COMPLETED=Authentication completed successfully.


# **  Exception Messages **

EXC_MSG_LINK_NOT_FOUND=Link not found for hash: %s
EXC_MSG_INVALID_LINK_HASH=Invalid link hash format: %s
EXC_MSG_USER_NOT_FOUND=User not found: %s
EXC_MSG_LINK_SCAN_NOT_FOUND=No scan result found for short code: %s
EXC_MSG_USERNAME_EXISTS=Username already exists: %s
EXC_MSG_LINK_ALREADY_REPORTED=This link has already been reported by this email
EXC_MSG_INVALID_OTP=Invalid or expired OTP
EXC_MSG_MISSING_FIELDS=At least one field (username, email, or password) must be provided for update
EXC_MSG_SHA256_UNAVAILABLE=SHA-256 algorithm is unavailable


# **  JWT / Security **

# Generate a secure random secret, e.g. with: openssl rand -base64 32
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
JWT_EXPIRY_DURATION_MINUTES=10


# **  VirusTotal **

# Get your API key by creating an account at VirusTotal.
VT_API_KEY=YOUR_VIRUSTOTAL_API_KEY
VT_ANALYSIS_URL=https://www.virustotal.com/api/v3/urls
VT_POLLING_INTERVAL_SECONDS=5
VT_POLLING_TIMEOUT_MINUTES=2

# **  IPInfo **

# Get your API token by creating an account at IPinfo.
IP_INFO_TOKEN=YOUR_IPINFO_TOKEN


# **  Email Provider - Brevo **

EMAIL_PROVIDER_BASE_URL=https://api.brevo.com/v3/smtp/email

# Get your API key by creating an account at Brevo.
EMAIL_PROVIDER_API_KEY=YOUR_BREVO_API_KEY

SENDER_NAME=Vishal from SmartLink
SENDER_EMAIL=noreply.urlshortener@gmail.com


# **  Email Subjects **

EMAIL_OTP_SUBJECT=One Time Password - SmartLink
EMAIL_REPORT_ACCEPTED_SUBJECT=Your report has been reviewed - SmartLink
EMAIL_MALICIOUS_LINK_SUBJECT=Your link has been flagged as malicious - SmartLink
EMAIL_LINK_CREATED_SUBJECT=Your short link is ready - SmartLink
EMAIL_WELCOME_SUBJECT=Welcome to SmartLink!