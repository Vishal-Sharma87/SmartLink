# SmartLink environment configuration
# Copy this file to .env and replace every CHANGE_ME value with your actual value.

SPRING_PROFILES_ACTIVE=local

MONGODB_URI=mongodb://localhost:27017/smartlink

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_JAAS_CONFIG=CHANGE_ME
KAFKA_SESSION_TIMEOUT=45000
KAFKA_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_VALUE_SERIALIZER=org.springframework.kafka.support.serializer.JsonSerializer
KAFKA_CONSUMER_GROUP_ID=smartlink-local-CHANGE_ME
KAFKA_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
KAFKA_VALUE_DESERIALIZER=org.springframework.kafka.support.serializer.JsonDeserializer

CLIENT_ID=smartlink-client-CHANGE_ME

COMPANY_DOMAIN=http://localhost:8080
COMPANY_ENDPOINT=http://localhost:8080

JWT_SECRET_KEY=CHANGE_ME

VT_API_KEY=CHANGE_ME
VT_ANALYSIS_URL=https://www.virustotal.com/api/v3/urls

SENDGRID_API_KEY=CHANGE_ME
SENDGRID_EMAIL=CHANGE_ME

IP_INFO_TOKEN=CHANGE_ME

MONGODB_DATABASE=smartlink
MONGODB_IMAGE_TAG=7.0
MONGODB_PORT=27017

REDIS_IMAGE_TAG=7.4-alpine

KAFKA_IMAGE_TAG=3.9.0
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost